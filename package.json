{
  "name": "burrow",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm --filter @burrow/server dev\" \"pnpm --filter @burrow/web dev\"",
    "build": "pnpm --filter @burrow/web build",
    "start": "pnpm --filter @burrow/server start",
    "burrow": "apps/tui/bin/burrow",
    "test": "vitest run",
    "test:tui": "pnpm --filter @burrow/tui test",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:tui",
    "prod:deploy": "scripts/deploy.sh",
    "prod:logs": "docker logs -f --tail 100 burrow",
    "prod:import-homebox": "docker exec burrow node --disable-warning=ExperimentalWarning apps/server/src/scripts/import-homebox.ts",
    "prod:migrate-assets": "docker exec burrow node --disable-warning=ExperimentalWarning apps/server/src/scripts/migrate-0004-assets.ts",
    "prod:migrate-roams": "docker exec burrow node --disable-warning=ExperimentalWarning apps/server/src/scripts/migrate-0005-roams.ts",
    "prod:migrate-kinds": "docker exec burrow node --disable-warning=ExperimentalWarning apps/server/src/scripts/migrate-0006-kinds.ts",
    "prod:token": "docker exec burrow node --disable-warning=ExperimentalWarning apps/server/src/scripts/token.ts",
    "prod:account": "docker exec -it burrow node --disable-warning=ExperimentalWarning apps/server/src/scripts/account.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1"
}
