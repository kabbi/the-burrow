# HomeBox (v0.27+, unified "entities" API). Base URL only, no /home suffix needed.
HOMEBOX_URL=http://fedora:3100
HOMEBOX_TOKEN=hb_...
# Set to 1 to let Burrow create/update entities in HomeBox. Off by default.
HOMEBOX_WRITE=0

PAPERLESS_NGX_URL=https://papers.example
PAPERLESS_NGX_TOKEN=...
# Set to 1 to serve a fake paperless with made-up documents (dev / UI tests).
PAPERLESS_MOCK=0

OLLAMA_URL=http://fedora:11434
OLLAMA_MODEL=qwen3.5:9b
# LM Studio (OpenAI-compatible). LLM_STUDIO_URL is accepted too.
LMSTUDIO_URL=http://worky:1234
LMSTUDIO_MODEL=google/gemma-4-31b
ANTHROPIC_API_KEY=sk-ant-...   # ANTROPIC_API_KEY (typo) is also accepted
ANTHROPIC_MODEL=claude-opus-5-5
# Quotes whose worst case is at or below this run without asking. 0 = always ask.
AI_AUTO_APPROVE_USD=0

BURROW_DB=./data/burrow.sqlite
PORT=4100

# Stable Fast 3D server (photo → .glb). Empty = off.
SF3D_URL=http://localhost:8765

# Where people open Burrow (links in Telegram messages), e.g. https://burrow.example.com
BURROW_PUBLIC_URL=
# Downloaded model files (image matcher). Default: data/models
BURROW_MODELS=

# Telegram photo bot (D-019). Runs when the token is set, unless TG_BOT=0.
# Only ONE Burrow may poll a token: set TG_BOT=0 on dev when production has it.
TG_BOT_TOKEN=
TG_BOT=
# Your chat id (only these chats get answers); more, comma-separated, in TG_ALLOWED_CHAT_IDS.
TG_ADMIN_CHAT_ID=
TG_ALLOWED_CHAT_IDS=
