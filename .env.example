# HomeBox (v0.27+, unified "entities" API). Base URL only, no /home suffix needed.
HOMEBOX_URL=http://fedora:3100
HOMEBOX_TOKEN=hb_...
# Set to 1 to let Burrow create/update entities in HomeBox. Off by default.
HOMEBOX_WRITE=0

PAPERLESS_NGX_URL=https://papers.example
PAPERLESS_NGX_TOKEN=...
# Set to 1 to serve a fake paperless with made-up documents (dev / UI tests).
PAPERLESS_MOCK=0

OLLAMA_URL=http://fedora:11434
ANTHROPIC_API_KEY=sk-ant-...   # ANTROPIC_API_KEY (typo) is also accepted

BURROW_DB=./data/burrow.sqlite
PORT=4100
